class ToleranceTableDialog(QtWidgets.QDialog):

    def __init__(self, pages, parent=None):
        super().__init__(parent or Gui.getMainWindow())
        self.pages = pages
        self._build_ui()

    def _build_ui(self):
        self.setWindowTitle("Insert Tolerance / Geometric Tables")
        self.setMinimumWidth(460)
        layout = QtWidgets.QVBoxLayout(self)

        # Page selector
        pg_row = QtWidgets.QHBoxLayout()
        pg_row.addWidget(QtWidgets.QLabel("Target Drawing Sheet:"))
        self.page_combo = QtWidgets.QComboBox()
        for p in self.pages:
            self.page_combo.addItem(p.Label, p)
        pg_row.addWidget(self.page_combo, 1)
        layout.addLayout(pg_row)

        layout.addWidget(_separator())

        # Table checkboxes
        grp = QtWidgets.QGroupBox("Select Table(s) to Insert")
        grp_lay = QtWidgets.QVBoxLayout(grp)
        self.checkboxes = []
        for display, key in zip(DISPLAY_LABELS, TABLE_LABELS):
            cb = QtWidgets.QCheckBox(display)
            cb.setProperty("table_key", key)
            grp_lay.addWidget(cb)
            self.checkboxes.append(cb)
        layout.addWidget(grp)

        # Select all / none
        sel_row = QtWidgets.QHBoxLayout()
        btn_all  = QtWidgets.QPushButton("Select All")
        btn_none = QtWidgets.QPushButton("Clear All")
        btn_all.clicked.connect(self._select_all)
        btn_none.clicked.connect(self._clear_all)
        sel_row.addWidget(btn_all)
        sel_row.addWidget(btn_none)
        sel_row.addStretch()
        layout.addLayout(sel_row)

        layout.addWidget(_separator())

        # Buttons
        btn_row = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
        )
        btn_row.button(QtWidgets.QDialogButtonBox.Ok).setText("Add Selected Tables")
        btn_row.accepted.connect(self._on_add)
        btn_row.rejected.connect(self.reject)
        layout.addWidget(btn_row)

    def _select_all(self):
        for cb in self.checkboxes:
            cb.setChecked(True)

    def _clear_all(self):
        for cb in self.checkboxes:
            cb.setChecked(False)

    def _on_add(self):
        selected = [cb.property("table_key") for cb in self.checkboxes if cb.isChecked()]
        if not selected:
            QtWidgets.QMessageBox.warning(self, "No Selection",
                                          "Please select at least one table.")
            return

        page_idx = self.page_combo.currentIndex()
        page = self.page_combo.itemData(page_idx)

        errors = []
        for tname in selected:
            try:
                insert_table_to_drawing(page, tname)
            except Exception as e:
                errors.append(f"{tname}: {e}")

        if errors:
            QtWidgets.QMessageBox.warning(
                self, "Some tables failed",
                "The following tables could not be inserted:\n\n" + "\n".join(errors)
            )
        else:
            QtWidgets.QMessageBox.information(
                self, "Done",
                f"{len(selected)} table(s) added to '{page.Label}'.\n\n"
                "Tip: Double-click a table in the drawing to move/edit it, "
                "or use the Data panel to adjust X/Y position and Scale."
            )
        self.accept()


def _separator():
    sep = QtWidgets.QFrame()
    sep.setFrameShape(QtWidgets.QFrame.HLine)
    sep.setFrameShadow(QtWidgets.QFrame.Sunken)
    return sep


# ─────────────────────────────────────────────────────────────────────────────
#  ENTRY POINT
# ─────────────────────────────────────────────────────────────────────────────

def main():
    doc = App.ActiveDocument
    if doc is None:
        QtWidgets.QMessageBox.critical(None, "No Document",
                                       "Please open a FreeCAD document first.")
        return

    # Collect TechDraw pages
    pages = [o for o in doc.Objects if o.isDerivedFrom("TechDraw::DrawPage")]
    if not pages:
        QtWidgets.QMessageBox.critical(None, "No Drawing Sheet",
                                       "No TechDraw drawing sheet found in the active document.\n"
                                       "Please create or open a drawing sheet first.")
        return

    dlg = ToleranceTableDialog(pages)
    dlg.exec_()


main()
