# ─────────────────────────────────────────────────────────────────────────────
#  INSERT SVG AS TECHDRAW ANNOTATION
# ─────────────────────────────────────────────────────────────────────────────

def insert_table_to_drawing(page, table_name):
    """Create a DrawViewAnnotation (SVG symbol) on the given TechDraw page."""
    doc = App.ActiveDocument

    td = table_def = TABLE_DEFS[table_name]
    svg_str = build_svg(table_def)

    # Unique feature name
    safe_name = "TolTable_" + "".join(c if c.isalnum() else "_" for c in table_name)
    existing = [o.Name for o in doc.Objects]
    counter = 1
    candidate = safe_name
    while candidate in existing:
        candidate = f"{safe_name}_{counter}"
        counter += 1
    feature_name = candidate

    # TechDraw SVG Symbol (movable annotation)
    import tempfile, os
    tmp = tempfile.NamedTemporaryFile(suffix=".svg", delete=False, mode="w", encoding="utf-8")
    tmp.write('<?xml version="1.0" encoding="utf-8"?>\n')
    tmp.write(svg_str)
    tmp.close()

    sym = doc.addObject("TechDraw::DrawViewSymbol", feature_name)
    sym.Label = ""   # suppress the name shown below the table on the sheet
    with open(tmp.name, "r", encoding="utf-8") as f:
        sym.Symbol = f.read()
    os.unlink(tmp.name)

    page.addView(sym)

    # Default position – centre of page
    try:
        sym.X = page.PageWidth  / 2
        sym.Y = page.PageHeight / 2
    except Exception:
        sym.X = 100.0
        sym.Y = 150.0

    sym.Scale = 1.0
    doc.recompute()
    App.Console.PrintMessage(f"[ToleranceTable] Added '{table_name}' to '{page.Label}'\n")
    return sym


