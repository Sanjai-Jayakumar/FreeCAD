# -*- coding: utf-8 -*-
# InsertToleranceTable.FCMacro
# Inserts standard tolerance/geometric tables into a FreeCAD TechDraw sheet.
# Tables are inserted as SVG annotations that are movable and editable.

import FreeCAD as App
import FreeCADGui as Gui
import TechDraw
import TechDrawGui
from PySide2 import QtWidgets, QtCore, QtGui
import math

# ─────────────────────────────────────────────────────────────────────────────
#  SVG TABLE BUILDER HELPERS
# ─────────────────────────────────────────────────────────────────────────────

FONT = "osifont"
FS   = 3.0     # normal font-size  (mm)
FSS  = 2.5     # small font-size   (mm)
FST  = 2.8     # title font-size   (mm)
RH   = 5.5     # row height (mm)
TH   = 6.5     # title row height (mm)
PAD      = 1.2    # cell horizontal padding (mm)
CHAR_W   = 1.45   # approx mm per character at FSS
MIN_COL  = 7.0    # minimum column width (mm)


def _s(v):
    """Format a float/int for SVG attribute."""
    return f"{v:.3f}"


def _xml_escape(s):
    """Escape characters that are invalid inside SVG/XML text nodes."""
    return (str(s)
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace('"', "&quot;"))


def _text(x, y, text, fs=FS, bold=False, anchor="middle"):
    fw = "bold" if bold else "normal"
    return (f'<text x="{_s(x)}" y="{_s(y)}" '
            f'font-family="{FONT}" font-size="{_s(fs)}" '
            f'font-weight="{fw}" text-anchor="{anchor}" '
            f'dominant-baseline="middle">{_xml_escape(text)}</text>')


def _rect(x, y, w, h, fill="none", sw=0.25):
    return (f'<rect x="{_s(x)}" y="{_s(y)}" width="{_s(w)}" height="{_s(h)}" '
            f'fill="{fill}" stroke="black" stroke-width="{_s(sw)}"/>')


def _hline(x1, y, x2, sw=0.25):
    return f'<line x1="{_s(x1)}" y1="{_s(y)}" x2="{_s(x2)}" y2="{_s(y)}" stroke="black" stroke-width="{_s(sw)}"/>'


def _vline(x, y1, y2, sw=0.25):
    return f'<line x1="{_s(x)}" y1="{_s(y1)}" x2="{_s(x)}" y2="{_s(y2)}" stroke="black" stroke-width="{_s(sw)}"/>'


def compute_auto_cols(headers, rows):
    """Auto-compute column widths (mm) from cell text content."""
    num_cols = max((len(r) for r in rows), default=1)
    col_w = [MIN_COL] * num_cols

    # Pass 1 – data rows and single-span header cells
    for row in rows:
        for i, cell in enumerate(row):
            text = cell[0] if isinstance(cell, tuple) else str(cell)
            w = len(text) * CHAR_W + 2 * PAD
            if w > col_w[i]:
                col_w[i] = w

    for hrow in headers:
        ci = 0
        for cell in hrow:
            text, span = (cell[0], int(cell[1])) if isinstance(cell, tuple) else (str(cell), 1)
            if span == 1:
                w = len(text) * CHAR_W + 2 * PAD
                if w > col_w[ci]:
                    col_w[ci] = w
            ci += span

    # Pass 2 – spanned header cells: expand proportionally if needed
    for hrow in headers:
        ci = 0
        for cell in hrow:
            text, span = (cell[0], int(cell[1])) if isinstance(cell, tuple) else (str(cell), 1)
            if span > 1:
                w_needed  = len(text) * CHAR_W + 2 * PAD
                w_current = sum(col_w[ci:ci + span])
                if w_needed > w_current:
                    extra = (w_needed - w_current) / span
                    for j in range(ci, ci + span):
                        col_w[j] += extra
            ci += span

    return col_w


def build_svg(table_def):
    """
    table_def = {
        "title"   : str,
        "cols"    : [col_width_mm, ...],       # column widths
        "headers" : [ [cell_text, ...], ...]   # list of header rows (merged cells use colspan via list of (text, span))
        "rows"    : [ [cell_text, ...], ... ]  # data rows
    }
    Returns an SVG string (no xml declaration, just <svg>…</svg>).
    """
    header_rows = table_def.get("headers", [])
    data_rows   = table_def.get("rows",    [])
    title       = table_def.get("title",   "")

    cols    = compute_auto_cols(header_rows, data_rows)
    total_w = sum(cols)

    # Ensure title text fits within the table width
    if title:
        title_min_w = len(title) * CHAR_W * (FST / FSS) + 2 * PAD
        if title_min_w > total_w:
            scale   = title_min_w / total_w
            cols    = [c * scale for c in cols]
            total_w = sum(cols)
    num_rows = len(header_rows) + len(data_rows)
    title_h  = TH if title else 0
    total_h  = title_h + num_rows * RH

    lines = []
    lines.append(f'<svg xmlns="http://www.w3.org/2000/svg" '
                 f'width="{_s(total_w)}mm" height="{_s(total_h)}mm" '
                 f'viewBox="0 0 {_s(total_w)} {_s(total_h)}">')

    # outer border
    lines.append(_rect(0, 0, total_w, total_h, sw=0.4))

    cy = 0.0

    # title row
    if title:
        lines.append(_rect(0, cy, total_w, TH))
        lines.append(_text(total_w / 2, cy + TH / 2, title, fs=FST, bold=True))
        cy += TH

    def _draw_row(row_cells, y, col_widths):
        """Draw one row. row_cells is list of str or (str, span_count)."""
        lines.append(_rect(0, y, total_w, RH))
        cx = 0.0
        ci = 0
        for cell in row_cells:
            if isinstance(cell, tuple):
                text, span = cell
            else:
                text, span = cell, 1
            cw = sum(col_widths[ci:ci+span])
            lines.append(_rect(cx, y, cw, RH))
            lines.append(_text(cx + cw / 2, y + RH / 2, str(text), fs=FSS))
            cx += cw
            ci += span

    # header rows
    for hr in header_rows:
        _draw_row(hr, cy, cols)
        cy += RH

    # data rows
    for dr in data_rows:
        _draw_row(dr, cy, cols)
        cy += RH

    lines.append('</svg>')
    return "\n".join(lines)


