# ---------------------------------------------------------------------------
# Category appearance colours — default values
# User overrides are saved to SETTINGS_FILE (JSON)
# ---------------------------------------------------------------------------
SETTINGS_FILE = os.path.join(
    os.path.expanduser("~"), "AppData", "Roaming", "FreeCAD",
    "Material", "ISM_appearance.json"
)

_DEFAULT_CATEGORY_COLORS = {
    "Sheet Metal": "#00b33c",
    "Tube":        "#3333cc",
    "Casting":     "#404040",
    "Alloys":      "#47476b",
    "Plastic":     "#004080",
    "Rubber":      "#008040",
}


def _load_colors():
    """Return the effective colour map (user overrides merged with defaults)."""
    import json
    colours = dict(_DEFAULT_CATEGORY_COLORS)
    try:
        if os.path.isfile(SETTINGS_FILE):
            with open(SETTINGS_FILE, "r", encoding="utf-8") as fh:
                saved = json.load(fh)
            for k, v in saved.items():
                if k in colours and isinstance(v, str) and v.startswith("#"):
                    colours[k] = v
    except Exception:
        pass
    return colours


def _save_colors(colour_map):
    """Persist user colour overrides to JSON."""
    import json
    try:
        folder = os.path.dirname(SETTINGS_FILE)
        if not os.path.isdir(folder):
            os.makedirs(folder)
        with open(SETTINGS_FILE, "w", encoding="utf-8") as fh:
            json.dump(colour_map, fh, indent=2)
    except Exception as e:
        FreeCAD.Console.PrintWarning(
            "[ApplyMaterial] Could not save colour settings: {}\n".format(e))


def _hex_to_rgb(hex_str):
    """Convert '#RRGGBB' to (r, g, b) float tuple 0-1."""
    h = hex_str.lstrip("#")
    if len(h) != 6:
        return (0.5, 0.5, 0.5)
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))


