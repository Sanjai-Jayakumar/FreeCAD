# ---------------------------------------------------------------------------
# Build .FCMat YAML content for one material
# ---------------------------------------------------------------------------
def _build_fcmat(cat_folder, mat_tuple):
    fname, name, desc, kind, std, density, youngs, poisson, uts, ys, sh, tc, te = mat_tuple
    cat = next(v for v in CATEGORIES.values() if v["folder"] == cat_folder)
    return (
        "---\n"
        "# Indian Standard Material - Generated by Apply Material macro\n"
        "General:\n"
        "  UUID: \"{uid}\"\n"
        "  Author: \"IndianStandardMaterials\"\n"
        "  License: \"CC-BY-4.0\"\n"
        "  Name: \"{name}\"\n"
        "  Description: \"{desc}\"\n"
        "Inherits:\n"
        "  {inh}:\n"
        "    UUID: \"{iuuid}\"\n"
        "Models:\n"
        "  Father:\n"
        "    UUID: '{fu}'\n"
        "    Father: \"Metal\"\n"
        "  MaterialStandard:\n"
        "    UUID: '{mu}'\n"
        "    KindOfMaterial: \"{kind}\"\n"
        "    StandardCode: \"{std}\"\n"
        "  Density:\n"
        "    UUID: '{du}'\n"
        "    Density: \"{density} kg/m^3\"\n"
        "  IsotropicLinearElastic:\n"
        "    UUID: '{eu}'\n"
        "    YoungsModulus: \"{youngs}\"\n"
        "    PoissonRatio: \"{poisson}\"\n"
        "    UltimateTensileStrength: \"{uts}\"\n"
        "    YieldStrength: \"{ys}\"\n"
        "  Thermal:\n"
        "    UUID: '{tu}'\n"
        "    SpecificHeat: \"{sh}\"\n"
        "    ThermalConductivity: \"{tc}\"\n"
        "    ThermalExpansionCoefficient: \"{te}\"\n"
    ).format(
        uid=str(uuid.uuid4()), name=name, desc=desc,
        inh=cat["inherit_name"], iuuid=cat["inherit_uuid"],
        fu=_U_FATHER, mu=_U_STDMODEL, du=_U_DENSITY, eu=_U_ELASTIC, tu=_U_THERMAL,
        kind=kind, std=std, density=density,
        youngs=youngs, poisson=poisson, uts=uts, ys=ys, sh=sh, tc=tc, te=te,
    )


